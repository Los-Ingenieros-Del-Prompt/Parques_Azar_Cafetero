<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.aguardientes.azarcafetero</groupId>
    <artifactId>parques-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>parques-service</name>
    <description>Microservicio de Parqués</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <!-- ✅ Sonar -->
        <sonar.organization>los-ingenieros-del-prompt</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>

                <!-- ✅ Exclusiones globales: aplican a report y check -->
                <configuration>
                    <excludes>
                        <!-- Clase main -->
                        <exclude>**/ParquesServiceApplication.class</exclude>
                        <!-- DTOs de entrada/salida (no tienen lógica) -->
                        <exclude>**/entrypoints/CreateGameRequest.class</exclude>
                        <exclude>**/entrypoints/CreateGameRequest$*.class</exclude>
                        <exclude>**/entrypoints/GameResponse.class</exclude>
                        <exclude>**/entrypoints/GameResponse$*.class</exclude>
                        <!-- DTOs de WebSocket -->
                        <exclude>**/websocket/dto/**</exclude>
                        <!-- Configuración de infraestructura -->
                        <exclude>**/infrastructure/GameConfig.class</exclude>
                        <exclude>**/infrastructure/websocket/WebSocketConfig.class</exclude>
                        <!-- Eventos de dominio (solo datos, sin lógica) -->
                        <exclude>**/domain/events/**</exclude>
                    </excludes>
                </configuration>

                <executions>
                    <!-- 1. Instrumenta el agente antes de los tests -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- 2. Genera el XML/HTML después de los tests -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                    <!-- 3. Verifica el umbral en la fase verify -->
                    <!-- ✅ Exclusiones repetidas para que check evalúe -->
                    <!--    exactamente las mismas clases que report      -->
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/ParquesServiceApplication.class</exclude>
                                <exclude>**/entrypoints/CreateGameRequest.class</exclude>
                                <exclude>**/entrypoints/CreateGameRequest$*.class</exclude>
                                <exclude>**/entrypoints/GameResponse.class</exclude>
                                <exclude>**/entrypoints/GameResponse$*.class</exclude>
                                <exclude>**/websocket/dto/**</exclude>
                                <exclude>**/infrastructure/GameConfig.class</exclude>
                                <exclude>**/infrastructure/websocket/WebSocketConfig.class</exclude>
                                <exclude>**/domain/events/**</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>